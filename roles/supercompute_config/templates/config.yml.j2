# Managed by supercompute_config — edit the worktree config.yml and re-run task up.
project: {{ project }}
hostname: {{ hostname }}
nameserver_hostname: {{ nameserver_hostname }}
hosts:
{% for node in groups['wireguard_nodes'] | sort %}
{% set node_vars = hostvars[node] %}
{% set node_lima = node_vars.node_lima_guest | default(false) | bool %}
{% set node_roaming = node_vars.wireguard_roaming | default(false) | bool %}
{% set node_type = 'lima' if node_lima else ('roaming' if node_roaming else 'public') %}
  - name: {{ node }}
    wireguard_address: "{{ node_vars.wireguard_address }}"
    type: {{ node_type }}
{% if node_type == 'public' and node_vars.wireguard_endpoint is defined and (node_vars.wireguard_endpoint | string | length) > 0 %}
    wireguard_endpoint: "{{ node_vars.wireguard_endpoint }}:{{ wireguard_listen_port }}"
{% endif %}
{% endfor %}
