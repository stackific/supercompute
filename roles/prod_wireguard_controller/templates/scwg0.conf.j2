[Interface]
PrivateKey = {{ vault_prod_wireguard_private_keys.macos }}
Address = {{ prod_wireguard_controller_address }}/{{ prod_wireguard_prefix_length }}
ListenPort = {{ prod_wireguard_listen_port }}
SaveConfig = false
{% set hub = hostvars['localhost'].prod_wireguard_hub | default('') %}
{% set roaming_nodes = hostvars['localhost'].prod_wireguard_roaming_nodes | default([]) %}
{% set use_hub = roaming_nodes | length > 0 %}
{% for node in groups['wireguard_nodes'] | sort %}
{% set roaming = hostvars[node].wireguard_roaming | default(false) | bool %}
{% if not (use_hub and roaming) %}
{% set allowed = [hostvars[node].prod_wireguard_address ~ '/32'] + (
  (roaming_nodes | map('extract', hostvars, 'prod_wireguard_address') | map('regex_replace', '^(.+)$', '\\1/32') | list)
  if (use_hub and node == hub) else []
) %}

[Peer]
# {{ node }}{{ ' (static hub; carries roaming)' if (use_hub and node == hub) else '' }}
PublicKey = {{ vault_prod_wireguard_public_keys[node] }}
AllowedIPs = {{ allowed | join(', ') }}
Endpoint = {{ hostvars[node].prod_wireguard_endpoint }}:{{ prod_wireguard_listen_port }}
PersistentKeepalive = 25
{% endif %}
{% endfor %}
