[Unit]
Description=rathole client (Supercompute roaming SSH bootstrap)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=2s
ExecStart={{ rathole_install_path }} --client {{ rathole_config_dir }}/client.toml

[Install]
WantedBy=multi-user.target
