[Unit]
Description=rathole server (Supercompute roaming SSH bootstrap)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Restart=always
RestartSec=2s
ExecStart={{ rathole_install_path }} --server {{ rathole_config_dir }}/server.toml

[Install]
WantedBy=multi-user.target
