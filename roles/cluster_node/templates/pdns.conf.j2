# Managed by cluster_node — PowerDNS Authoritative.
# Mesh address always; public VPS address too when set (NS delegation).
setuid=pdns
setgid=pdns
{% if cluster_geoip_enabled | bool %}
launch=geoip
geoip-database-files={{ cluster_geoip_db_path }}
geoip-zones-file={{ cluster_pdns_geoip_zones_path }}
edns-subnet-processing=yes
{% else %}
launch=bind
bind-config={{ cluster_pdns_bind_named_conf_path }}
{% endif %}
local-address={{ cluster_pdns_listen_address }}
local-port=53
cache-ttl=60
query-cache-ttl=60
distributor-threads=1
receiver-threads=1
guardian=no
daemon=no
log-timestamp=yes
loglevel=4
include-dir=/etc/powerdns/pdns.d
