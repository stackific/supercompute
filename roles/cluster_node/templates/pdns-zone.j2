; Managed by cluster_node — static authoritative zone (no MaxMind GeoIP).
$ORIGIN {{ cluster_pdns_zone }}.
$TTL 60
@   IN  SOA {{ cluster_pdns_ns_hostname }}. hostmaster.{{ cluster_pdns_zone }}. (
        {{ ansible_facts['date_time']['epoch'] }} ; serial
        7200 ; refresh
        3600 ; retry
        1209600 ; expire
        60 ) ; minimum
    IN  NS  {{ cluster_pdns_ns_hostname }}.
    IN  A   {{ hostvars[cluster_static_hub_host].prod_wireguard_address }}
