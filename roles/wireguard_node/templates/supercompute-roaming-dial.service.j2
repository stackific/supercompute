[Unit]
Description=Supercompute roaming WireGuard dial (random public static)
After=wg-quick@{{ wireguard_interface }}.service
Requires=wg-quick@{{ wireguard_interface }}.service

[Service]
Type=oneshot
Environment=SUPERCOMPUTE_WG_IFACE={{ wireguard_interface }}
Environment=SUPERCOMPUTE_PUBLIC_ENDPOINTS=/etc/supercompute/public-endpoints.list
Environment=SUPERCOMPUTE_TRANSIT_IPS=/etc/supercompute/roaming-transit.ips
ExecStart=/usr/local/sbin/supercompute-roaming-dial
