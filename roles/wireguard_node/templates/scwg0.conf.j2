[Interface]
PrivateKey = {{ vault_wireguard_private_keys[inventory_hostname] }}
Address = {{ wireguard_address }}/{{ wireguard_prefix_length }}
ListenPort = {{ wireguard_listen_port }}
SaveConfig = false
{% set hub = hostvars['localhost'].wireguard_hub | default('') %}
{% set roaming_nodes = hostvars['localhost'].wireguard_roaming_nodes | default([]) %}
{% set use_hub = roaming_nodes | length > 0 %}
{% set self_roaming = wireguard_roaming | default(false) | bool %}
{% if use_hub and inventory_hostname == hub %}
{# ip_forward is applied by the role (drop-in + sysctl -w). PostUp only restores iptables on boot. #}
PostUp = iptables -C FORWARD -i %i -o %i -j ACCEPT 2>/dev/null || iptables -A FORWARD -i %i -o %i -j ACCEPT
PostDown = iptables -D FORWARD -i %i -o %i -j ACCEPT 2>/dev/null || true
{% endif %}
{% if not self_roaming %}

[Peer]
# macOS controller. Its current endpoint is learned from the authenticated
# keepalive it sends, so a controller with a dynamic public address works.
PublicKey = {{ vault_wireguard_public_keys.macos }}
AllowedIPs = {{ wireguard_controller_address }}/32
{% endif %}
{% for peer in groups['wireguard_nodes'] | sort if peer != inventory_hostname %}
{% set peer_roaming = hostvars[peer].wireguard_roaming | default(false) | bool %}
{% if self_roaming and peer_roaming %}
{# No direct roaming↔roaming peer (no stable Endpoint). Spoke↔spoke goes via hub. #}
{% elif self_roaming %}
{% set ns = namespace(other_roaming_ips=[]) %}
{% for r in roaming_nodes if r != inventory_hostname %}
{% if hostvars[r].wireguard_address is defined
   and (hostvars[r].wireguard_address | string | length) > 0 %}
{% set _ = ns.other_roaming_ips.append(hostvars[r].wireguard_address ~ '/32') %}
{% endif %}
{% endfor %}
{% set allowed = [hostvars[peer].wireguard_address ~ '/32'] + (
  ([wireguard_controller_address ~ '/32'] + ns.other_roaming_ips)
  if (use_hub and peer == hub) else []
) %}

[Peer]
# {{ peer }}{{ ' (static hub; Mac + other roaming via hub)' if (use_hub and peer == hub) else '' }}
PublicKey = {{ vault_wireguard_public_keys[peer] }}
AllowedIPs = {{ allowed | join(', ') }}
Endpoint = {{ hostvars[peer].wireguard_endpoint }}:{{ wireguard_listen_port }}
PersistentKeepalive = 25
{% else %}

[Peer]
# {{ peer }}{{ ' (roaming; initiates)' if peer_roaming else '' }}
PublicKey = {{ vault_wireguard_public_keys[peer] }}
AllowedIPs = {{ hostvars[peer].wireguard_address }}/32
{% if not peer_roaming %}
Endpoint = {{ hostvars[peer].wireguard_endpoint }}:{{ wireguard_listen_port }}
PersistentKeepalive = 25
{% endif %}
{% endif %}
{% endfor %}
