[Interface]
PrivateKey = {{ vault_wireguard_private_keys[inventory_hostname] }}
Address = {{ private_address }}/{{ node_prefix_length }}
ListenPort = {{ node_listen_port }}
SaveConfig = false
{% set hub = hostvars['localhost'].static_hub | default('') %}
{% set roaming_nodes = hostvars['localhost'].roaming_nodes | default([]) %}
{% set static_nodes = hostvars['localhost'].static_nodes | default([]) %}
{% set use_hub = roaming_nodes | length > 0 %}
{% set self_roaming = roaming | default(false) | bool %}
{% set forward_here = use_hub and (not self_roaming) and (
  (node_forward_on_all_statics | default(true) | bool)
  or inventory_hostname == hub
) %}
{% if forward_here %}
{# ip_forward is applied by the role (drop-in + sysctl -w). PostUp only restores iptables on boot. #}
PostUp = iptables -C FORWARD -i %i -o %i -j ACCEPT 2>/dev/null || iptables -A FORWARD -i %i -o %i -j ACCEPT
PostDown = iptables -D FORWARD -i %i -o %i -j ACCEPT 2>/dev/null || true
{% endif %}
{% if (node_include_controller_peer | default(true) | bool) and (not self_roaming) %}

[Peer]
# macOS controller. Its current endpoint is learned from the authenticated
# keepalive it sends, so a controller with a dynamic public address works.
PublicKey = {{ vault_wireguard_public_keys.macos }}
AllowedIPs = {{ node_controller_address }}/32
{% endif %}
{% for peer in groups['nodes'] | sort if peer != inventory_hostname %}
{% set peer_roaming = hostvars[peer].roaming | default(false) | bool %}
{% if self_roaming and peer_roaming %}
{# No direct roaming↔roaming peer (no stable Endpoint). Spoke↔spoke goes via hub. #}
{% elif self_roaming %}
{% set ns = namespace(other_roaming_ips=[]) %}
{% for r in roaming_nodes if r != inventory_hostname %}
{% if hostvars[r].private_address is defined
   and (hostvars[r].private_address | string | length) > 0 %}
{% set _ = ns.other_roaming_ips.append(hostvars[r].private_address ~ '/32') %}
{% endif %}
{% endfor %}
{% set transit = ns.other_roaming_ips + (
  [node_controller_address ~ '/32']
  if (node_include_controller_peer | default(true) | bool) else []
) %}
{% set allowed = [hostvars[peer].private_address ~ '/32'] + (
  transit if (use_hub and peer == hub) else []
) %}

[Peer]
# {{ peer }}{{ ' (build-up hub; transit AllowedIPs; Endpoint rotated post-up)' if (use_hub and peer == hub) else '' }}
PublicKey = {{ vault_wireguard_public_keys[peer] }}
AllowedIPs = {{ allowed | join(', ') }}
{% if use_hub and peer == hub %}
Endpoint = {{ hostvars[peer].public_ip }}:{{ node_listen_port }}
PersistentKeepalive = 25
{% endif %}
{% else %}

[Peer]
# {{ peer }}{{ ' (roaming; initiates)' if peer_roaming else '' }}
PublicKey = {{ vault_wireguard_public_keys[peer] }}
AllowedIPs = {{ hostvars[peer].private_address }}/32
{% if not peer_roaming %}
Endpoint = {{ hostvars[peer].public_ip }}:{{ node_listen_port }}
PersistentKeepalive = 25
{% endif %}
{% endif %}
{% endfor %}
