[Interface]
PrivateKey = {{ vault_prod_wireguard_private_keys[inventory_hostname] }}
Address = {{ prod_wireguard_node_addresses[inventory_hostname] }}/{{ prod_wireguard_prefix_length }}
ListenPort = {{ prod_wireguard_listen_port }}
SaveConfig = false

[Peer]
# macOS controller. Its current endpoint is learned from the authenticated
# keepalive it sends, so a controller with a dynamic public address works.
PublicKey = {{ vault_prod_wireguard_public_keys.macos }}
AllowedIPs = {{ prod_wireguard_controller_address }}/32
{% for peer in groups['wireguard_nodes'] | sort if peer != inventory_hostname %}

[Peer]
# {{ peer }}
PublicKey = {{ vault_prod_wireguard_public_keys[peer] }}
AllowedIPs = {{ prod_wireguard_node_addresses[peer] }}/32
Endpoint = {{ hostvars[peer].prod_wireguard_endpoint }}:{{ prod_wireguard_listen_port }}
PersistentKeepalive = 25
{% endfor %}
