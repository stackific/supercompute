table inet manual_wireguard {
  chain input {
    type filter hook input priority -10;
    policy accept;

    ct state invalid drop
    iifname "wg0" ip saddr {{ wireguard_macos_address }} tcp dport 22 accept
    iifname "eth0" ip saddr {{ wireguard_lima_user_v2_subnet }} tcp dport 22 ct state established accept
    tcp dport 22 drop
    iifname "lo" accept
    ct state established,related accept
    iifname "wg0" ip saddr { {{ wireguard_macos_address }}, {% for node in lima_nodes %}{{ node.wg_address }}{{ ", " if not loop.last else "" }}{% endfor %} } icmp type echo-request accept
    iifname "eth0" udp sport 67 udp dport 68 accept
    iifname "eth0" ip saddr {{ wireguard_lima_user_v2_subnet }} udp dport {{ wireguard_listen_port }} accept
    tcp dport { 80, 443 } accept
    drop
  }
}
