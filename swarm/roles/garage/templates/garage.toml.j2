metadata_dir = "/var/lib/garage/metadata"
data_dir = "/var/lib/garage/data"
db_engine = "sqlite"
replication_factor = 1

rpc_bind_addr = "[::]:3901"
rpc_public_addr = "127.0.0.1:3901"
rpc_secret = "{{ vault_garage_rpc_secret }}"

[s3_api]
s3_region = "{{ garage_region }}"
api_bind_addr = "[::]:{{ garage_s3_container_port }}"
root_domain = ".s3.garage.localhost"

[s3_web]
bind_addr = "[::]:3902"
root_domain = ".web.garage.localhost"
index = "index.html"

[admin]
api_bind_addr = "[::]:3903"
admin_token = "{{ vault_garage_admin_token }}"
metrics_token = "{{ vault_garage_metrics_token }}"
