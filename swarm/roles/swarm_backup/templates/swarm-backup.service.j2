[Unit]
Description={{ deployment_name }} encrypted cold manager-state backup
Wants=network-online.target
After=network-online.target docker.service
ConditionPathIsDirectory=/var/lib/docker/swarm

[Service]
Type=oneshot
User=root
Group=root
ExecStart={{ swarm_backup_runner_path }} --config {{ swarm_backup_config_path }}
# If the runner is interrupted after stopping Docker, systemd still restores
# this manager's daemon and safely returns the uniquely labeled node to Active.
ExecStopPost=/usr/bin/systemctl start docker.socket docker.service
ExecStopPost={{ swarm_backup_runner_path }} --config {{ swarm_backup_config_path }} --restore-active
TimeoutStartSec=30min
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths={{ swarm_backup_runtime_dir }} /run /var/lib/docker
