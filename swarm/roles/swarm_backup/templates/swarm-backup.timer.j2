[Unit]
Description=Run {{ deployment_name }} cold manager-state backup every six hours

[Timer]
OnActiveSec={{ swarm_backup_timer_interval_seconds }}s
OnUnitInactiveSec={{ swarm_backup_timer_interval_seconds }}s
AccuracySec=1s
Persistent=false
Unit={{ swarm_backup_service }}

[Install]
WantedBy=timers.target
